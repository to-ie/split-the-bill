<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The camera is the only hardware this app uses. There is deliberately no
         INTERNET permission: OCR runs on-device and nothing is uploaded, and
         leaving the permission out turns that from a promise into something
         the OS enforces. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The camera and image_picker plugins each merge their own permissions
         into this manifest, which is how INTERNET, ACCESS_NETWORK_STATE and
         RECORD_AUDIO ended up in the release build. None of them are used:
         the OCR model ships inside the APK (assets/mlkit-google-ocr-models),
         audio is disabled on the camera, and there is no network code.

         Removing INTERNET is the point. It turns "receipts never leave your
         phone" from a claim in the README into something Android enforces.
         Verify after any dependency change with:
           aapt2 dump permissions build/app/outputs/flutter-apk/app-arm64-v8a-release.apk
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

    <!-- Android Auto Backup is on by default, and it uploads the app's data
         directory to the user's Google Drive. For this app that is every
         receipt, every friend's name and the PIN, which is precisely what it
         promises never to send anywhere. Both the pre-12 flag and the 12+
         rules file are set, because the old flag alone stops being the whole
         story on newer releases. -->
    <application
        android:label="Split the Bill"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Brief section 5: have the OCR model present on the device rather
             than fetched on first use, so the app can be tested with network
             access denied. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
